{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/feishu-digital-twin/codex-decision.schema.json",
  "title": "Feishu digital twin decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "outcome",
    "reason",
    "response",
    "commands",
    "lookup_requests",
    "action_requests",
    "source_refs"
  ],
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "outcome": { "enum": ["ignore", "reply", "confirm"] },
    "reason": { "type": "string", "minLength": 1 },
    "response": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "text"],
          "properties": {
            "mode": { "enum": ["representative", "suggestion", "confirmation"] },
            "text": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "commands": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["argv", "reason", "confirmation"],
        "properties": {
          "argv": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string", "minLength": 1 }
          },
          "reason": { "type": "string", "minLength": 1 },
          "confirmation": { "enum": ["auto", "human"] }
        }
      }
    },
    "lookup_requests": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "operation", "input", "reason"],
        "properties": {
          "capability": { "type": "string", "minLength": 1 },
          "operation": { "type": "string", "minLength": 1 },
          "input": { "type": "string", "minLength": 2, "maxLength": 8192 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "action_requests": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "operation", "input", "reason"],
        "properties": {
          "capability": { "type": "string", "minLength": 1 },
          "operation": { "type": "string", "minLength": 1 },
          "input": { "type": "string", "minLength": 2, "maxLength": 8192 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
